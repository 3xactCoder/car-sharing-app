# Database settings
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/car_sharing_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT Security
JWT_SECRET=your_base64_or_hex_jwt_secret_key_at_least_256_bits_long
JWT_EXPIRATION=86400000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BOT_NAME=your_telegram_bot_username

# Stripe API (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_secret_key_from_stripe_dashboard
